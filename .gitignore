# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# arquivos gerados a partir de node_modules/.ifc (scripts/copy-bim-assets.mjs)
/public/wasm/
/public/fragments/
/public/ifc/
/public/ar/

# prisma client gerado
/src/generated/

# skills instaladas por ferramentas (prisma init)
/.agents/
/.windsurf/
/.claude/
skills-lock.json

# testes
/test-results/
/playwright-report/

.vercel
/.storage/
!.env.example
