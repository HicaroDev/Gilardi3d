# ---------------------------------------------------------------------------
# Gilardi 3D — variáveis de ambiente
# Copie para .env (local) e configure as mesmas chaves na Vercel (Production/Preview).
# ---------------------------------------------------------------------------

# PostgreSQL (produção: Neon via Vercel Marketplace — use a URL "pooled").
# Local: `npm run db:local` sobe um Postgres do Prisma e mostra a URL TCP.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Auth.js — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# URL pública (links de redefinição de senha e de compartilhamento).
# Na Vercel, se vazia, usa VERCEL_PROJECT_PRODUCTION_URL automaticamente.
APP_URL="http://localhost:3000"

# Vercel Blob (store PRIVADA). Sem token → arquivos em .storage/ (só desenvolvimento).
BLOB_READ_WRITE_TOKEN=""

# Limite por arquivo IFC, em MB.
MAX_UPLOAD_MB=1024

# E-mail (Resend). Sem chave → o link de redefinição aparece no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="Gilardi 3D <nao-responda@seudominio.com>"

# Opcional: tamanho do pool de conexões do Postgres por instância.
DB_POOL_MAX=5

# Plataforma completa (login, projetos, upload, compartilhamento).
# false/ausente = site mostra só o modelo em destaque e NÃO precisa de banco/storage.
NEXT_PUBLIC_PLATFORM_ENABLED=false
